NODE_ENV=development
PORT=8080
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://revive:revive@localhost:5432/revive_psg1
DATABASE_CA_PATH=
DATABASE_CA_PEM=
VALKEY_URL=redis://localhost:6379
SESSION_TOKEN_SECRET=replace-with-at-least-32-random-bytes
LICENSE_PRIVATE_KEY_PEM=
LICENSE_PUBLIC_KEY_PEM=
LICENSE_KEY_ID=license-dev-1
RELEASE_PUBLIC_KEY_PEM=
SOLANA_RPC_PRIMARY=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK=
TREASURY_WALLET=EAjkNpwau3hB58C2M4U8rQWFANHRidA8XiB4Dvq78T4y
SPACES_REGION=nyc3
SPACES_BUCKET=revive-psg1-artifacts
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
CRASH_REPORTS_ENABLED=true
EARLY_ACCESS_FREE=false
REVIVE_DEV_HARDWARE_FIXTURE=false
PUBLIC_SALES_ENABLED=false
# Authoritative server availability: scan_only | private_beta | public.
INSTALLER_MODE=scan_only
# Runtime emergency brake: blocks new destructive boundaries while preserving
# a previously started device's exact signed resume path.
INSTALLER_NEW_STARTS_ENABLED=true
# Deprecated compatibility flags retained only for old deployments; they do
# not override INSTALLER_MODE.
COMPATIBILITY_CHECKER_ONLY=true
BETA_BROWSER_INSTALLER=false
BETA_HARDWARE_PILOT_ENABLED=false
# cohort (default) or hardware_pilot (one lifetime invite; only for a signed pilot-pending release)
BETA_INVITE_KIND=cohort
