{
  "name": "@revive-psg1/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build -w @revive-psg1/contracts && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build -w @revive-psg1/contracts && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:beta-invite": "tsx src/db/create-beta-invite.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@revive-psg1/contracts": "0.1.0",
    "bs58": "^6.0.0",
    "canonicalize": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "postgres": "^3.4.7",
    "tweetnacl": "^1.0.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.6",
    "vitest": "^4.0.0"
  }
}
